{
  "name": "voltronix-crm-next",
  "version": "0.1.0",
  "private": true,
  "description": "CRM migration targeting MySQL, with a preserved SQLite regression implementation and isolated local preparation.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "npm run contracts:build && next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint .",
    "typecheck": "npm run contracts:build && next typegen && tsc --noEmit",
    "test": "npm run contracts:build && tsx --test tests/*.test.ts",
    "test:http": "tsx scripts/verify-mysql-offline-http.ts",
    "test:settings:http": "tsx scripts/verify-settings-http.ts",
    "config:check": "tsx scripts/check-frontend-config.ts",
    "mysql:config": "tsx scripts/mysql-config.ts",
    "mysql:inspect": "tsx scripts/mysql-inspect.ts",
    "verify:local": "tsx scripts/verify-local-evidence.ts",
    "staging:http": "tsx scripts/verify-staging-http.ts",
    "db:inspect": "tsx scripts/sqlite-command-gate.ts",
    "db:migrate": "tsx scripts/sqlite-command-gate.ts",
    "db:backup": "tsx scripts/sqlite-command-gate.ts",
    "db:verify-backup": "tsx scripts/sqlite-command-gate.ts",
    "dev:user": "tsx scripts/create-development-user.ts",
    "sqlite:inspect": "tsx scripts/inspect-schema.ts",
    "sqlite:migrate": "tsx scripts/migrate.ts",
    "sqlite:backup": "tsx scripts/backup.ts",
    "sqlite:verify-backup": "tsx scripts/verify-backup.ts",
    "sqlite:config": "tsx scripts/check-config.ts",
    "test:sqlite:http": "tsx scripts/verify-auth-http.ts && tsx scripts/verify-settings-http.ts && tsx scripts/verify-crm-http.ts && tsx scripts/verify-lead-mutations-http.ts && tsx scripts/verify-workflows-http.ts && tsx scripts/verify-commercial-http.ts",
    "mysql:migrate": "tsx scripts/mysql-migrate.ts",
    "test:mysql": "tsx scripts/run-mysql-integration.ts",
    "contracts:build": "npm --prefix ../shared/contracts run build"
  },
  "dependencies": {
    "@next/env": "16.4.0",
    "@voltronix/crm-contracts": "file:../shared/contracts",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "fflate": "0.8.3",
    "mysql2": "3.24.5",
    "next": "16.4.0",
    "pdfkit": "0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
