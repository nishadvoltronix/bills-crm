# Public, database-independent foundation only. Store the real service environment
# OUTSIDE the release, in /etc/bills-crm/frontend.env, with restricted permissions.
# 3301/3302 are examples: verify both ports are unused before selecting them.
NODE_ENV=production
APP_ORIGIN=https://bills.voltronix.ae
CRM_API_INSTANCE_ID=bills-crm
CRM_DATABASE_MODE=disabled
CRM_MYSQL_NETWORK_DISABLED=1
ZOHO_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
CRM_WEB_HOST=127.0.0.1
CRM_WEB_PORT=3301
CRM_FRONTEND_BACKEND=express
CRM_EXPRESS_ORIGIN=http://127.0.0.1:3302
