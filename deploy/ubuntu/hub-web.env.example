# Nonsecret template for /etc/hub-crm/frontend.env, outside the release.
# Read as data: node tools/run-hub.mjs build|check-web|web --env-file /etc/hub-crm/frontend.env
# The launcher excludes database credentials from frontend build/runtime environments.
# PM2 stores only the external configuration path; it does not receive DB credentials.
NODE_ENV=production
APP_ORIGIN=https://hub.voltronix.ae
CRM_API_INSTANCE_ID=hub-crm
ZOHO_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
# The HTTPS proxy on 192.168.30.20 reaches this exact dedicated interface.
# Restrict TCP 3090 on the application host to that proxy; 0.0.0.0 is refused.
CRM_WEB_HOST=192.168.30.21
CRM_WEB_PORT=3090
CRM_FRONTEND_BACKEND=express
CRM_EXPRESS_ORIGIN=http://127.0.0.1:3002
