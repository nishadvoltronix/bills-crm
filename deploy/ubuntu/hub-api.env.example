# Incomplete template for /etc/hub-crm/backend.env, outside the release.
# Owner: the API service user (or root when the reader is root); mode 0600.
# Parent directories must be root/service-owned and not group/other writable.
# Read as data: node tools/run-hub.mjs check-api|api --env-file /etc/hub-crm/backend.env
# Fill each blank from the new dedicated HUB database's actual reviewed setup.
# No existing application's schema, credentials, users or data may be reused.
NODE_ENV=production
APP_ORIGIN=https://hub.voltronix.ae
CRM_API_INSTANCE_ID=hub-crm
ZOHO_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
CRM_API_ENVIRONMENT=production
CRM_API_HOST=127.0.0.1
CRM_API_PORT=3002
CRM_RUNTIME_ENABLE=approved-production-mysql-crm-runtime
CRM_RUNTIME_SOURCE=environment
CRM_MYSQL_HOST=127.0.0.1
CRM_MYSQL_PORT=3306
CRM_MYSQL_DATABASE=voltronix_hub
CRM_MYSQL_USER=
CRM_MYSQL_PASSWORD=
CRM_MYSQL_SERVER_UUID=
CRM_MYSQL_APPROVED=true
CRM_MYSQL_APPROVAL_REFERENCE=
CRM_MYSQL_PROVISIONING_REFERENCE=
# Supported companies: VOLTRONIX CONTRACTING LLC or VOLTRONIX SWITCHGEAR LLC.
# The salesperson is an approved display name, never a default login account.
CRM_MYSQL_ISSUER_COMPANY=
CRM_MYSQL_ISSUER_SALESPERSON=
