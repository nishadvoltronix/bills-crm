# Public, database-independent foundation only. Store the real service environment
# OUTSIDE the release, in /etc/bills-crm/backend.env, with restricted permissions.
# No MySQL credentials, runtime profile or Zoho credentials belong in this profile.
NODE_ENV=production
APP_ORIGIN=https://bills.voltronix.ae
CRM_API_INSTANCE_ID=bills-crm
CRM_DATABASE_MODE=disabled
CRM_MYSQL_NETWORK_DISABLED=1
ZOHO_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
CRM_API_ENVIRONMENT=production
CRM_API_HOST=127.0.0.1
CRM_API_PORT=3302
