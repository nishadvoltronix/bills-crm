# MANUAL TEMPLATE ONLY: review the deployment guide and staging evidence first.
# Install as /etc/systemd/system/voltronix-crm-web.service only after approval.
# Node 24.x must be installed at /usr/bin/node (verify the actual host path).
# Before start, create only this release's .next/cache, owned by
# voltronix-crm-web, mode 0700. Do not grant write access to the release itself.
[Unit]
Description=Voltronix CRM Next.js frontend
Documentation=file:/srv/voltronix-crm/current/docs/manual-deployment-guide.md
Wants=network-online.target voltronix-crm-api.service
After=network-online.target voltronix-crm-api.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=voltronix-crm-web
Group=voltronix-crm-web
WorkingDirectory=/srv/voltronix-crm/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/voltronix-crm/frontend.env
ExecStartPre=/usr/bin/test -f /srv/voltronix-crm/current/.next/BUILD_ID
ExecStart=/usr/bin/node /srv/voltronix-crm/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3001
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=60
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/srv/voltronix-crm/current
ReadWritePaths=/srv/voltronix-crm/current/.next/cache
InaccessiblePaths=-/srv/voltronix-crm/current/server/.local-data
InaccessiblePaths=-/srv/voltronix-crm/current/server/.env
InaccessiblePaths=-/etc/voltronix-crm/backend.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voltronix-crm-web

# No MemoryDenyWriteExecute: Node/V8 needs JIT executable memory.
# Express unavailability is a redacted 503, never direct-Next database fallback.
# Wants (not Requires) allows the frontend to recover when the API restarts;
# its own process being active does not certify dependency readiness.
[Install]
WantedBy=multi-user.target
