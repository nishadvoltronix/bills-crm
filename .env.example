# Safe, nonactive template for the Next.js server-side Express bridge.
# The SQLite demo launcher supplies these values; no frontend .env is required.
# For separate local startup, set these in the frontend process environment.
# These are server-only settings: do NOT prefix any of them with NEXT_PUBLIC_.
CRM_FRONTEND_BACKEND=express
CRM_EXPRESS_ORIGIN=http://127.0.0.1:3002
APP_ORIGIN=http://127.0.0.1:3001
# This template is for local development. For the HTTPS Bills foundation use the
# separate deploy/ubuntu/bills-{web,api}.env.example profiles and run-bills.mjs.
# The HTTPS bridge requires matching API service identity before forwarding credentials.
# Database credentials, sessions, integrations and secrets belong only in backend.
