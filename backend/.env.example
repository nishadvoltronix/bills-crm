# Backend CLI and config:check load backend/.env independently of shell location.
# Explicit process values win. Missing .env is allowed when the process supplies
# its settings. The seven active defaults below keep the local foundation unchanged.
# Required for the API foundation; these safe local values do not select a DB.
# npm run config:check validates these without opening a listener or database.
CRM_API_ENVIRONMENT=development
CRM_API_HOST=127.0.0.1
CRM_API_PORT=3002
APP_ORIGIN=http://127.0.0.1:3001

# Optional MySQL selectors: leave blank unless a real, separately approved
# private JSON profile exists. Blank values do not enable MySQL. Actual values:
# CRM_RUNTIME_ENABLE: approved-local-mysql-crm-runtime
# CRM_RUNTIME_PROFILE: .local-data/operators/mysql-crm-runtime.json
# Alternatively production can explicitly select CRM_RUNTIME_SOURCE=environment.
# Exact production settings and private storage: ../docs/backend-production-environment.md.
# Never mix environment credentials and the private JSON profile.
CRM_RUNTIME_ENABLE=
CRM_RUNTIME_PROFILE=

# Optional safety switch: 1 refuses all MySQL driver connections. Blank means
# no additional switch, NOT approval to connect. Keep 1 for foundation-only use.
CRM_MYSQL_NETWORK_DISABLED=1

# The SQLite demo launcher supplies its own controlled process environment and
# intentionally does not load this file. It does not relocate or reseed data.
# No SESSION_SECRET, upload-path or NEXT_PUBLIC_* reader is implemented.
# ZOHO_ENABLED=false accepts inactive backend settings; true refuses startup.
# Zoho synchronization itself is NOT implemented. Never reuse exposed credentials.
# Sandbox testing uses a separate private grant, not these production values:
# npm --prefix backend run zoho:sandbox:setup (run from repository root).
# See ../docs/zoho-sandbox-execution-plan.md; metadata-only completion exits 2.
# Sandbox is optional. Inspect the existing grant's production field metadata:
# npm --prefix backend run zoho:inspect (read-only; no settings/records changed).
# Metadata inspection is not runtime/synchronization acceptance; keep sync off.
# Fresh normal zoho:setup consent also requests org.READ/users.READ. It replaces
# the saved refresh token only after a successful interactive exchange; refreshing
# an old grant cannot add scopes. No setup or replacement runs automatically.
# Deal source-profile selection is code composition only, not a supported env key.
# Sessions, upload limits and local-only security boundaries stay source-controlled.
# See ../docs/crm-environment-guide.md for the supported runtime contract.

# Production-only optional keys (commented; not active demo settings):
# CRM_RUNTIME_SOURCE=environment
# CRM_MYSQL_HOST=127.0.0.1
# CRM_MYSQL_PORT=3306
# CRM_MYSQL_DATABASE=<approved-schema>
# CRM_MYSQL_USER=<approved-runtime-user>
# CRM_MYSQL_PASSWORD=<private-new-runtime-password>
# CRM_MYSQL_SERVER_UUID=<verified-target-uuid>
# CRM_MYSQL_APPROVED=true
# CRM_MYSQL_APPROVAL_REFERENCE=<actual-owner-approval>
# CRM_MYSQL_PROVISIONING_REFERENCE=<actual-provisioning-reference>
# CRM_MYSQL_ISSUER_COMPANY=<approved-supported-company>
# CRM_MYSQL_ISSUER_SALESPERSON=<approved-display-name>
# ZOHO_ENABLED=false
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
